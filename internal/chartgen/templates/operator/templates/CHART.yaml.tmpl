{{/* Code generated by chartgen. DO NOT EDIT. */}}
{{/*
The [[ .CRKind ]] custom resource. Only fields from .Values.[[ .Name ]].spec render,
so Helm does not own fields that the values leave out.
*/}}
{{- $spec := deepCopy (.Values.[[ .Name ]].spec | default dict) }}
[[- if .DeferUninstallStrategy ]]
{{- /*
KubeVirt hashes spec.uninstallStrategy into its install strategy, so a change of
the field rolls all KubeVirt components. When the chart adopts a running KubeVirt
that has no uninstallStrategy, the chart leaves the field out until the version
changes. The upgrade rolls the components anyway, and sets the field at that time.
*/}}
{{- if hasKey $spec "uninstallStrategy" }}
{{- $live := lookup "[[ .CRAPIVersion ]]" "[[ .CRKind ]]" [[ if .CRNamespaced ]].Release.Namespace[[ else ]]""[[ end ]] "[[ .CRName ]]" }}
{{- if $live }}
{{- $liveStrategy := dig "spec" "uninstallStrategy" "" $live }}
{{- $observed := dig "status" "[[ .ObservedVersionField ]]" "" $live }}
{{- if and (not $liveStrategy) (eq $observed .Values.image.tag) }}
{{- $_ := unset $spec "uninstallStrategy" }}
{{- end }}
{{- end }}
{{- end }}
[[- end ]]
apiVersion: [[ .CRAPIVersion ]]
kind: [[ .CRKind ]]
metadata:
  name: [[ .CRName ]]
  [[- if .CRNamespaced ]]
  namespace: {{ .Release.Namespace }}
  [[- end ]]
  annotations:
    helm.sh/resource-policy: keep
    {{- with .Values.[[ .Name ]].annotations }}
    {{- toYaml . | nindent 4 }}
    {{- end }}
  {{- with .Values.[[ .Name ]].labels }}
  labels:
    {{- toYaml . | nindent 4 }}
  {{- end }}
{{- with $spec }}
spec:
  {{- toYaml . | nindent 2 }}
{{- end }}
