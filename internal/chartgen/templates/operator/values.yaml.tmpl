# Code generated by chartgen from [[ .Repo ]] [[ .Tag ]]. DO NOT EDIT.

# Images of the operator Deployment. The defaults are the upstream images.
image:
  # Registry and repository prefix of every image.
  registry: [[ .ImageRegistry ]]
  # Tag of every image. The chart also writes this value to [[ range $i, $e := .VersionEnv ]][[ if $i ]], [[ end ]][[ $e ]][[ end ]].
  # Keep the "v" prefix.
  tag: [[ .Tag ]]
  # Full image references by image name. A key here replaces registry/name:tag.
  # Image names: [[ range $i, $e := .Images ]][[ if $i ]], [[ end ]][[ $e ]][[ end ]].
  # Example:
  #   [[ index .Images 0 ]]: registry.example.com/kubevirt/[[ index .Images 0 ]]@sha256:...
  overrides: {}

# The [[ .CRKind ]] custom resource ([[ .CRName ]]).
[[ .Name ]]:
  # Extra annotations and labels on the custom resource.
  annotations: {}
  labels: {}
  # The chart renders spec as is. Helm owns only the fields that are set here.
  # Fields that are not set here (for example feature gates that another controller
  # patches at runtime) stay untouched on install, adoption, and upgrade.
  # The defaults are the spec of the upstream [[ .CRFile ]] for [[ .Tag ]] without empty
  # fields, plus uninstallStrategy. To remove a default field, set it to null.
[[- if .DeferUninstallStrategy ]]
  # KubeVirt rolls all components when uninstallStrategy changes. If the chart adopts
  # a running KubeVirt that has no uninstallStrategy, the chart sets the field only at
  # the next version change.
[[- end ]]
[[- if .FollowImageTag ]]
  # The operator uses spec.imageTag for every component except itself. If the live
  # custom resource has spec.imageTag, and spec here does not set imageTag, the chart
  # sets spec.imageTag to image.tag. Thus a chart upgrade moves all components. If the
  # live custom resource has no spec.imageTag, the chart does not render the field.
  # To pin another tag, set spec.imageTag here.
[[- end ]]
  spec:
[[ .CRSpecYAML ]]

# Hook Jobs that run before install and before upgrade.
hooks:
  # Image with kubectl as the entrypoint.
  image: registry.k8s.io/kubectl:v1.34.2
  imagePullPolicy: IfNotPresent
  # Labels the release namespace with the labels of the upstream Namespace:
  # [[ range $i, $e := .NamespaceLabels ]][[ if $i ]], [[ end ]][[ $e ]][[ end ]]
  namespaceLabels:
    enabled: true
  # Applies crds/[[ .CRDName ]].yaml, because Helm never upgrades files in crds/.
  crd:
    enabled: true
  nodeSelector: {}
  tolerations: []
  resources: {}
